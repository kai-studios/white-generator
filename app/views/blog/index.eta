<% layout('../layout', it) %>
<%~ include('../partials/page-head', { title: 'Blog', lead: 'Short notes on how White.js works.' }) %>
<ul class="post-list">
  <% it.posts.forEach((post, i) => { %>
  <li data-reveal style="--i:<%= i %>">
    <a href="/blog/<%= post.slug %>">
      <span class="meta"><%= post.dateLabel %></span>
      <h2><%= post.title %></h2>
      <p><%= post.summary %></p>
      <span class="post-list__arrow" aria-hidden="true">→</span>
    </a>
  </li>
  <% }) %>
</ul>
