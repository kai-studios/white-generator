<% layout('./layout', it) %>
<%~ include('./partials/page-head', { title: 'Contact', lead: 'A demo form. The server validates it with zod; nothing is stored or sent.' }) %>

<% if (it.sent) { %>
<div class="notice" role="status">
  <svg class="check" viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="12"/><path d="m8.5 14.5 3.8 3.8 7.2-8"/></svg>
  Thanks! Your message was accepted.
</div>
<% } %>

<div class="contact">
  <ul class="contact__aside" data-rise style="--i:2">
    <li><span><strong>Checked twice.</strong> Your browser submits the form and the server validates it with the same schema as the API.</span></li>
    <li><span><strong>Works without JavaScript.</strong> With it, the page sends the message in the background and shows the result in place.</span></li>
    <li><span><strong>Nothing is stored.</strong> This is a demo; a real site would save or send the message in <code>server/routes/client/contact.js</code>.</span></li>
  </ul>

  <div data-rise style="--i:3">
    <form class="form" method="post" action="/contact" novalidate>
      <%~ include('./partials/field', { name: 'name', label: 'Name', value: it.values.name, errors: it.errors, max: it.limits.name, autocomplete: 'name', placeholder: 'Ada Lovelace' }) %>
      <%~ include('./partials/field', { name: 'email', label: 'Email', type: 'email', value: it.values.email, errors: it.errors, autocomplete: 'email', placeholder: 'ada@example.com' }) %>
      <%~ include('./partials/field', { name: 'message', label: 'Message', value: it.values.message, errors: it.errors, max: it.limits.message, multiline: true, placeholder: 'What would you like to say?' }) %>
      <%~ include('./partials/button', { label: 'Send message', type: 'submit' }) %>
    </form>

    <div class="success" id="success" hidden>
      <svg class="check" viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="12"/><path d="m8.5 14.5 3.8 3.8 7.2-8"/></svg>
      <h2>Message accepted</h2>
      <p>The server validated it and answered 202. Nothing was stored.</p>
      <%~ include('./partials/button', { label: 'Send another', variant: 'ghost', size: 'sm', class: 'success__again' }) %>
    </div>
  </div>
</div>

<%/* Inline scripts need the per-request nonce. it.w.json() makes data safe to embed. */%>
<script nonce="<%= it.nonce %>">window.__LIMITS__ = <%~ it.w.json(it.limits) %>;</script>
<script type="module" src="<%= it.w.asset('/js/contact.js') %>"></script>
