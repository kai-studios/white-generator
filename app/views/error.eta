<%
  const headings = { 403: 'Not allowed', 404: 'Page not found', 429: 'Too many requests' };
  const heading = headings[it.status] || (it.status >= 500 ? 'Something went wrong' : 'Request failed');
  layout('./layout', { ...it, title: String(it.status) });
%>
<section class="error-page">
  <p class="error-code" data-rise><%= it.status %></p>
  <h1 data-rise style="--i:1"><%= heading %></h1>
  <p class="lead" data-rise style="--i:2"><%= it.message %></p>
  <p class="actions" data-rise style="--i:3"><%~ include('./partials/button', { href: '/', label: 'Back to the home page', arrow: true }) %></p>
</section>
