<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title ? it.title + ' · ' + it.site.name : it.site.name + ' · ' + it.site.tagline %></title>
  <meta name="description" content="<%= it.description || it.site.tagline %>">
  <link rel="icon" href="<%= it.w.asset('/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= it.w.asset('/css/style.css') %>">
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <%~ include('./partials/header', it) %>
  <main id="content" class="container">
    <%~ it.body %>
  </main>
  <%~ include('./partials/footer', it) %>
</body>
</html>
