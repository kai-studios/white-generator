<%
  // The lines `white run dev` prints, typed in one by one with CSS only.
  const routes = [
    ['GET', '/'], ['GET', '/api/status'], ['POST', '/api/messages'],
    ['GET', '/blog'], ['GET', '/blog/:slug'], ['GET', '/contact'], ['POST', '/contact'],
  ];
%>
<div class="terminal" role="img" aria-label="Terminal output of white run dev, listing the routes of this site">
  <div class="terminal__bar"><i></i><i></i><i></i><span class="terminal__title">~/site</span></div>
  <div class="terminal__body" aria-hidden="true">
    <span class="terminal__line" style="--i:0"><span class="prompt">$</span> npm run dev</span>
    <span class="terminal__line" style="--i:1"> </span>
    <% routes.forEach(([method, path], i) => { %>
    <span class="terminal__line" style="--i:<%= i + 2 %>"><span class="method <%= method.toLowerCase() %>"><%= method %></span>  <%= path %></span>
    <% }) %>
    <span class="terminal__line" style="--i:<%= routes.length + 2 %>"> </span>
    <span class="terminal__line" style="--i:<%= routes.length + 3 %>"><span class="dim">Local:</span>  <span class="link">http://localhost:3000</span><span class="terminal__cursor"></span></span>
  </div>
</div>
