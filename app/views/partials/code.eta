<%
  // Code block with a copy button (the button needs JavaScript and is hidden without it).
  // Parameters: code, file (optional caption).
%>
<figure class="code<%= it.file ? '' : ' code--bare' %>">
  <figcaption class="code__bar">
    <span class="code__file"><%= it.file || '' %></span>
    <button class="code__copy" type="button" data-copy aria-label="Copy code"><span>Copy</span></button>
  </figcaption>
  <pre><code><%= it.code %></code></pre>
</figure>
