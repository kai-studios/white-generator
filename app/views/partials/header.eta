<%
  const links = [['/', 'Home'], ['/blog', 'Blog'], ['/contact', 'Contact']];
  const current = it.path || '';
%>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <img src="<%= it.w.asset('/favicon.svg') %>" width="26" height="26" alt="">
      <span><%= it.site.name %></span>
    </a>
    <nav class="nav" aria-label="Main">
      <span class="nav__pill" aria-hidden="true"></span>
      <% for (const [href, label] of links) {
           const active = href === '/' ? current === '/' : current.startsWith(href); %>
      <a href="<%= href %>"<% if (active) { %> aria-current="page"<% } %>><%= label %></a>
      <% } %>
    </nav>
  </div>
</header>
